@page
@model HB_Claude.Pages.EventsModel
@using HB_Claude.Models
@{
    ViewData["Title"] = "Matchhändelser";
    Layout = "_Layout";
}

<style>
    .btn-event { min-width: 100px; min-height: 38px; font-size: 0.8rem; margin: 2px; padding: 4px 6px; }
    .btn-zon { min-width: 70px; min-height: 32px; font-size: 0.8rem; margin: 2px; padding: 3px 6px; }
    .player-btn { min-width: 130px; min-height: 32px; font-size: 0.8rem; margin: 2px; padding: 3px 6px; text-align: left; }
    .player-btn.active { background-color: #0d6efd; color: white; }
    .mv-type.active { background-color: #0d6efd; color: white; border-color: #0d6efd; }
    .mv-place { min-width: 84px; min-height: 42px; font-size: 0.75rem; margin: 2px; padding: 3px 6px; }
    #mvPlacement.disabled { opacity: .45; pointer-events: none; }
    #matchklocka { font-size: 1.8rem; font-weight: bold; font-family: monospace; }
    .section-header { background-color: #6c757d; color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.8rem; margin-bottom: 2px; }
    .form-select-sm { padding-top: 2px; padding-bottom: 2px; }
    .gap-tight { gap: 0.3rem !important; margin-bottom: 0.3rem !important; }
</style>

<div id="mmOfflineBar"></div>

<div class="row">
    <!-- Vänster kolumn: lag, match, spellare -->
    <div class="col-md-4">
        <form method="post" id="mainForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MatchTid" id="matchTidInput" />
            <input type="hidden" asp-for="AktivSpelareID" id="aktivSpelarInput" />
            <input type="hidden" asp-for="AktivSpelarPosition" id="aktivSpelarPosition" />
            <input type="hidden" asp-for="HandelseTyp" id="handelseTypInput" />
            <input type="hidden" asp-for="ZonVal" id="zonValInput" />
            <input type="hidden" asp-for="FasVal" id="fasValInput" />

            <!-- Lag & Match -->
            <div class="row g-2 mb-1">
                <div class="col-6">
                    <select asp-for="ValtLagID" class="form-select form-select-sm" id="lagSelect" onchange="this.form.submit()" name="ValtLagID">
                        @foreach (var l in Model.LagLista)
                        {
                            <option value="@l.LagID" selected="@(l.LagID == Model.ValtLagID ? "selected" : null)">@l.Namn</option>
                        }
                    </select>
                </div>
                <div class="col-6">
                    <select asp-for="ValtMatchID" class="form-select form-select-sm" id="matchSelect" onchange="bytMatch()" name="ValtMatchID">
                        <option value="">Välj match</option>
                        @foreach (var m in Model.MatchLista)
                        {
                            <option value="@m.MatchID" selected="@(m.MatchID == Model.ValtMatchID ? "selected" : null)">@m.Datum - @m.Motståndare</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Match info & klocka -->
            <div class="d-flex align-items-center gap-2 mb-1">
                <span id="matchklocka">@Model.TidText</span>
                <button type="submit" asp-page-handler="StartStop" id="startStopBtn" class="btn btn-sm @(Model.MatchStatus == "Pågående" ? "btn-danger" : "btn-success")">
                    @(Model.MatchStatus == "Pågående" ? "Stop" : "Start")
                </button>
                <button type="submit" asp-page-handler="PausFortsatt" class="btn btn-sm btn-warning" id="pausBtn"
                        disabled="@(Model.MatchStatus != "Pågående" ? "disabled" : null)">
                    @(Model.IsPaus ? "Fortsätt" : "Paus")
                </button>
                <a asp-page="/NyaMatcher" class="btn btn-sm btn-outline-primary">+ Ny match</a>
            </div>

            @if (!string.IsNullOrEmpty(Model.StatusText))
            {
                <div class="alert alert-info py-1 mb-1 small"><strong>@Model.StatusText</strong></div>
            }
            @if (!string.IsNullOrEmpty(Model.SummaryText))
            {
                <div class="alert alert-secondary py-1 mb-1 small">@Model.SummaryText</div>
            }
            @if (!string.IsNullOrEmpty(Model.Felmeddelande))
            {
                <div class="alert alert-danger py-1 mb-1 small">@Model.Felmeddelande</div>
            }

            <!-- Spelarelista -->
            @if (Model.SpelareLista.Any())
            {
                <div class="section-header">Välj spelare</div>
                <div class="d-flex flex-wrap mb-1" id="spelareContainer">
                    @foreach (var sp in Model.SpelareLista)
                    {
                        <button type="button"
                                class="btn btn-outline-dark player-btn @(sp.SpID == Model.AktivSpelareID ? "active" : "")"
                                onclick="välj('@sp.SpID', '@sp.position')"
                                data-spid="@sp.SpID"
                                data-position="@sp.position">
                            @sp.Namn
                        </button>
                    }
                </div>
            }

            <!-- Zon (visas ej för MV) -->
            <div id="zonSection" style="display:@(Model.AktivSpelarPosition == "MV" || string.IsNullOrEmpty(Model.AktivSpelareID) ? "none" : "block")">
                <div class="section-header">Zon</div>
                <div class="d-flex flex-wrap mb-1">
                    <input type="radio" class="btn-check" name="zonRadio" id="zonV1" value="1" onchange="setZon('1')" @(Model.ZonVal == "1" ? "checked" : "")>
                    <label class="btn btn-outline-secondary btn-zon" for="zonV1">V1</label>
                    <input type="radio" class="btn-check" name="zonRadio" id="zonV2" value="2" onchange="setZon('2')" @(Model.ZonVal == "2" ? "checked" : "")>
                    <label class="btn btn-outline-secondary btn-zon" for="zonV2">V2</label>
                    <input type="radio" class="btn-check" name="zonRadio" id="zonO3" value="3" onchange="setZon('3')" @(Model.ZonVal == "3" ? "checked" : "")>
                    <label class="btn btn-outline-secondary btn-zon" for="zonO3">Mitt</label>
                    <input type="radio" class="btn-check" name="zonRadio" id="zonH2" value="4" onchange="setZon('4')" @(Model.ZonVal == "4" ? "checked" : "")>
                    <label class="btn btn-outline-secondary btn-zon" for="zonH2">H2</label>
                    <input type="radio" class="btn-check" name="zonRadio" id="zonH1" value="5" onchange="setZon('5')" @(Model.ZonVal == "5" ? "checked" : "")>
                    <label class="btn btn-outline-secondary btn-zon" for="zonH1">H1</label>
                </div>

                <!-- Fas -->
                <div class="section-header">Fas</div>
                <div class="d-flex flex-wrap mb-1">
                    <input type="radio" class="btn-check" name="fasRadio" id="fasUpp" value="1" onchange="setFas('1')" @(Model.FasVal == "1" || string.IsNullOrEmpty(Model.FasVal) ? "checked" : "")>
                    <label class="btn btn-outline-secondary btn-zon" for="fasUpp">Uppst.</label>
                    <input type="radio" class="btn-check" name="fasRadio" id="fas1" value="2" onchange="setFas('2')" @(Model.FasVal == "2" ? "checked" : "")>
                    <label class="btn btn-outline-secondary btn-zon" for="fas1">Fas 1</label>
                    <input type="radio" class="btn-check" name="fasRadio" id="fas2" value="3" onchange="setFas('3')" @(Model.FasVal == "3" ? "checked" : "")>
                    <label class="btn btn-outline-secondary btn-zon" for="fas2">Fas 2</label>
                </div>

                <!-- Fältspelarhändelser -->
                <div class="section-header">Händelse - fältspelare</div>
                <div class="d-flex flex-wrap mb-1">
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-success btn-event" onclick="setHändelse('_6m')">6M</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-success btn-event" onclick="setHändelse('_9m')">9M</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-success btn-event" onclick="setHändelse('Genombrott')">Genombrott</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-success btn-event" onclick="setHändelse('_Straff_Mål_')">Straff</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-warning btn-event" onclick="setHändelse('Räddning_')">Räddning</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-warning btn-event" onclick="setHändelse('Utanför_')">Utanför</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-warning btn-event" onclick="setHändelse('Skott_i_täcket')">I täcket</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-danger btn-event" onclick="setHändelse('Övertramp')">Övertramp</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-danger btn-event" onclick="setHändelse('Offensiv_stuermer')">Off. sturmare</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-danger btn-event" onclick="setHändelse('Stegfel')">Stegfel</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-danger btn-event" onclick="setHändelse('Passmiss')">Passmiss</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-danger btn-event" onclick="setHändelse('Tappad_boll')">Tappad boll</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-danger btn-event" onclick="setHändelse('Fot')">Fot</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-danger btn-event" onclick="setHändelse('Dubbelstuds')">Dubbelstuds</button>
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-secondary btn-event" onclick="setHändelse('Assist')">Assist</button>
                </div>
            </div>

            <!-- Målvaktshändelser: välj typ, sedan skottplacering (3x3) -->
            <div id="mvSection" style="display:@(Model.AktivSpelarPosition == "MV" ? "block" : "none")">
                <div class="section-header">Målvakt - välj typ</div>
                <div class="d-flex flex-wrap mb-1" id="mvTypeRow">
                    <button type="button" class="btn btn-outline-success btn-event mv-type" onclick="setMvType('Räddning 6M', this)">Räddning 6M</button>
                    <button type="button" class="btn btn-outline-success btn-event mv-type" onclick="setMvType('Räddning 9M', this)">Räddning 9M</button>
                    <button type="button" class="btn btn-outline-success btn-event mv-type" onclick="setMvType('Räddning Genombrott', this)">Räddning Genom.</button>
                    <button type="button" class="btn btn-outline-success btn-event mv-type" onclick="setMvType('Straff räddning', this)">Straff räddning</button>
                    <button type="button" class="btn btn-outline-danger btn-event mv-type" onclick="setMvType('Mål 6M', this)">Mål 6M</button>
                    <button type="button" class="btn btn-outline-danger btn-event mv-type" onclick="setMvType('Mål 9M', this)">Mål 9M</button>
                    <button type="button" class="btn btn-outline-danger btn-event mv-type" onclick="setMvType('Mål Genombrott', this)">Mål Genombrott</button>
                    <button type="button" class="btn btn-outline-danger btn-event mv-type" onclick="setMvType('Straff mål', this)">Straff mål</button>
                </div>
                <div class="section-header">Placering <span id="mvHint" class="fw-normal ms-1"></span></div>
                <div id="mvPlacement" class="mb-1 disabled">
                    <div class="d-flex">
                        <button type="submit" asp-page-handler="Händelse" class="btn btn-outline-secondary mv-place" onclick="return setMvHändelse('Uppe vänster')">Uppe V</button>
                        <button type="submit" asp-page-handler="Händelse" class="btn btn-outline-secondary mv-place" onclick="return setMvHändelse('Uppe mitten')">Uppe M</button>
                        <button type="submit" asp-page-handler="Händelse" class="btn btn-outline-secondary mv-place" onclick="return setMvHändelse('Uppe höger')">Uppe H</button>
                    </div>
                    <div class="d-flex">
                        <button type="submit" asp-page-handler="Händelse" class="btn btn-outline-secondary mv-place" onclick="return setMvHändelse('Mitten vänster')">Mitten V</button>
                        <button type="submit" asp-page-handler="Händelse" class="btn btn-outline-secondary mv-place" onclick="return setMvHändelse('Mitten mitten')">Mitten M</button>
                        <button type="submit" asp-page-handler="Händelse" class="btn btn-outline-secondary mv-place" onclick="return setMvHändelse('Mitten höger')">Mitten H</button>
                    </div>
                    <div class="d-flex">
                        <button type="submit" asp-page-handler="Händelse" class="btn btn-outline-secondary mv-place" onclick="return setMvHändelse('Nere vänster')">Nere V</button>
                        <button type="submit" asp-page-handler="Händelse" class="btn btn-outline-secondary mv-place" onclick="return setMvHändelse('Nere mitten')">Nere M</button>
                        <button type="submit" asp-page-handler="Händelse" class="btn btn-outline-secondary mv-place" onclick="return setMvHändelse('Nere höger')">Nere H</button>
                    </div>
                </div>
                <div class="d-flex flex-wrap mb-1">
                    <button type="submit" asp-page-handler="Händelse" class="btn btn-danger btn-event" onclick="setHändelse('M_TeknisktFel')">Tekniskt fel</button>
                </div>
            </div>

        </form>
    </div>

    <!-- Höger kolumn: händelsetabell -->
    <div class="col-md-8">
        <div id="mmQueueSummary"></div>
        <div id="mmQueue"></div>
        @if (Model.Händelser.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover small">
                    <thead class="table-dark">
                        <tr>
                            <th>Tid</th>
                            <th>Spelare</th>
                            <th>Händelse</th>
                            <th>T.Fel</th>
                            <th>Zon</th>
                            <th>Mål</th>
                            <th>Avslut</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.Händelser)
                        {
                            <tr>
                                <td>@h.Tid</td>
                                <td>@h.Namn</td>
                                <td>@h.Händelse</td>
                                <td>@(h.TeknisktFel == "1" ? "X" : "")</td>
                                <td>@h.Zon</td>
                                <td>@(h.Mål == "1" ? "X" : "")</td>
                                <td>@(h.Avslut == "1" ? "X" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script src="~/js/offline-events.js" asp-append-version="true"></script>
<script>
    // Match timer — use C# booleans to avoid HTML-encoding of Swedish characters
    var matchPagaende = @(Model.MatchStatus == "Pågående" ? "true" : "false");
    var isPaus = @(Model.IsPaus ? "true" : "false");
    var matchTidSeconds = @Model.MatchTid;
    var timerInterval = null;

    // Kontext + status som JSON (JsonSerializer escapar svenska tecken korrekt för JS)
    var mmCtx = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { lagId = Model.ValtLagID, matchId = Model.ValtMatchID, matchStatus = Model.MatchStatus }));
    var matchStatusStr = mmCtx.matchStatus;
    var CLOCK_KEY = 'mm_clock';

    function persistClock() {
        try {
            localStorage.setItem(CLOCK_KEY, JSON.stringify({
                matchId: mmCtx.matchId, sec: matchTidSeconds, isPaus: isPaus,
                pagaende: matchPagaende, status: matchStatusStr, ts: Date.now()
            }));
        } catch (e) { }
    }

    // Offline: återställ klocka/status från localStorage så den överlever reload utan nät
    (function restoreClock() {
        try {
            if (navigator.onLine) return;
            var raw = localStorage.getItem(CLOCK_KEY);
            if (!raw) return;
            var st = JSON.parse(raw);
            if (st && st.matchId === mmCtx.matchId) {
                matchTidSeconds = st.sec || 0;
                isPaus = !!st.isPaus;
                matchPagaende = !!st.pagaende;
                matchStatusStr = st.status || matchStatusStr;
            }
        } catch (e) { }
    })();

    function updateKlocka() {
        var min = Math.floor(matchTidSeconds / 60);
        var sec = matchTidSeconds % 60;
        document.getElementById('matchklocka').textContent =
            String(min).padStart(2, '0') + ':' + String(sec).padStart(2, '0');
        document.getElementById('matchTidInput').value = matchTidSeconds;
    }

    function startTimer() {
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(function () {
            if (!isPaus) {
                matchTidSeconds++;
                updateKlocka();
                persistClock();
            }
        }, 1000);
    }

    function updateStartStopBtn() {
        var b = document.getElementById('startStopBtn');
        if (b) {
            if (matchStatusStr === 'Pågående') { b.textContent = 'Stop'; b.className = 'btn btn-sm btn-danger'; }
            else { b.textContent = 'Start'; b.className = 'btn btn-sm btn-success'; }
        }
        var pb = document.getElementById('pausBtn');
        if (pb) pb.disabled = (matchStatusStr !== 'Pågående');
    }
    function updatePausBtn() {
        var pb = document.getElementById('pausBtn');
        if (pb) pb.textContent = isPaus ? 'Fortsätt' : 'Paus';
    }

    // API som offline-lagret (offline-events.js) styr klockan igenom
    window.mmClock = {
        seconds: function () { return matchTidSeconds; },
        status: function () { return matchStatusStr; },
        togglePaus: function () {
            isPaus = !isPaus;
            if (!isPaus && matchPagaende) startTimer();
            updatePausBtn(); persistClock();
        },
        start: function () {
            matchStatusStr = 'Pågående'; matchPagaende = true; isPaus = false; matchTidSeconds = 0;
            updateKlocka(); startTimer(); updateStartStopBtn(); updatePausBtn(); persistClock();
        },
        setStatus: function (s) {
            matchStatusStr = s; matchPagaende = (s === 'Pågående');
            if (s !== 'Pågående') { isPaus = true; if (timerInterval) clearInterval(timerInterval); }
            updateStartStopBtn(); updatePausBtn(); persistClock();
        }
    };

    if (matchPagaende && !isPaus) {
        startTimer();
    }

    updateKlocka();

    function välj(spid, position) {
        document.getElementById('aktivSpelarInput').value = spid;
        document.getElementById('aktivSpelarPosition').value = position;
        resetMvSelection();

        document.querySelectorAll('.player-btn').forEach(function (b) {
            b.classList.toggle('active', b.dataset.spid === spid);
        });

        if (position === 'MV') {
            document.getElementById('zonSection').style.display = 'none';
            document.getElementById('mvSection').style.display = 'block';
        } else {
            document.getElementById('zonSection').style.display = 'block';
            document.getElementById('mvSection').style.display = 'none';
        }
    }

    function setHändelse(typ) {
        document.getElementById('handelseTypInput').value = typ;
        document.getElementById('matchTidInput').value = matchTidSeconds;
    }

    // Målvakt: två steg – välj typ, sedan skottplacering i 3x3-rutnätet
    var mvType = '';
    function setMvType(typ, btn) {
        mvType = typ;
        document.querySelectorAll('.mv-type').forEach(function (b) { b.classList.remove('active'); });
        if (btn) btn.classList.add('active');
        document.getElementById('mvPlacement').classList.remove('disabled');
        var h = document.getElementById('mvHint');
        if (h) h.textContent = '– ' + typ + ': välj var skottet gick';
    }
    function setMvHändelse(placering) {
        if (!mvType) {
            var h = document.getElementById('mvHint');
            if (h) h.textContent = '– välj händelsetyp först!';
            return false; // blockerar submit
        }
        document.getElementById('handelseTypInput').value = mvType + ': ' + placering;
        document.getElementById('matchTidInput').value = matchTidSeconds;
        return true;
    }
    function resetMvSelection() {
        mvType = '';
        document.querySelectorAll('.mv-type.active').forEach(function (b) { b.classList.remove('active'); });
        var p = document.getElementById('mvPlacement'); if (p) p.classList.add('disabled');
        var h = document.getElementById('mvHint'); if (h) h.textContent = '';
    }
    window.resetMvSelection = resetMvSelection;

    function setZon(zon) {
        document.getElementById('zonValInput').value = zon;
    }

    function setFas(fas) {
        document.getElementById('fasValInput').value = fas;
    }

    function bytMatch() {
        var matchId = document.getElementById('matchSelect').value;
        if (matchId) {
            document.getElementById('mainForm').submit();
        }
    }

    // Init fas/zon
    document.getElementById('fasValInput').value = document.getElementById('fasValInput').value || '1';
    document.getElementById('zonValInput').value = document.getElementById('zonValInput').value || '0';

    // Starta offline-lagret
    mmCtx.token = (document.querySelector('input[name="__RequestVerificationToken"]') || {}).value || '';
    if (window.MM) MM.init(mmCtx);
</script>
}
