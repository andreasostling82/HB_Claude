@page
@model HB_Claude.Pages.GlömtModel
@{
    ViewData["Title"] = "Glömt lösenord";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body">
                <h3 class="card-title text-center mb-4">Glömt lösenord</h3>
                @if (!string.IsNullOrEmpty(Model.Meddelande))
                {
                    <div class="alert @(Model.Success ? "alert-success" : "alert-danger")">@Model.Meddelande</div>
                }
                @if (!Model.Success)
                {
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">E-post</label>
                            <input asp-for="Epost" type="email" class="form-control" placeholder="din@epost.se" />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Skicka nytt lösenord</button>
                        </div>
                    </form>
                }
                <div class="mt-3 text-center">
                    <a asp-page="/Index">Tillbaka till inloggning</a>
                </div>
            </div>
        </div>
    </div>
</div>
