@page
@model HB_Claude.Pages.NyttLagModel
@{
    ViewData["Title"] = "Nytt lag";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <h4>Skapa nytt lag</h4>
        @if (!string.IsNullOrEmpty(Model.Meddelande))
        {
            <div class="alert @(Model.Success ? "alert-success" : "alert-danger")">@Model.Meddelande</div>
        }
        @if (!Model.Success)
        {
            <form method="post">
                <div class="mb-2">
                    <label class="form-label">Lagnamn</label>
                    <input asp-for="LagNamn" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Hemmaplan</label>
                    <input asp-for="HemmaHall" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Serie</label>
                    <input asp-for="Serie" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Herr/Dam</label>
                    <select asp-for="KM" class="form-select">
                        <option value="M">Herr</option>
                        <option value="W">Dam</option>
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Skapa lag</button>
                    <a asp-page="/Lagbygge" class="btn btn-secondary">Avbryt</a>
                </div>
            </form>
        }
        else
        {
            <a asp-page="/Lagbygge" class="btn btn-primary">Gå till lagbygge</a>
        }
    </div>
</div>
