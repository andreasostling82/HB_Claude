<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>@ViewData["Title"] - MatchMate</title>

    <!-- PWA -->
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#c8282a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="MatchMate" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/icons/favicon-16.png" />

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HB_Claude.styles.css" asp-append-version="true" />
</head>
<body style="background-color: var(--bg); color: var(--text)">
    @if (Context.Session.GetString("user") != null)
    {
        <nav class="navbar navbar-expand-sm mb-3" style="background: var(--surface); border-bottom: 3px solid var(--red); box-shadow: 0 2px 8px rgba(0,0,0,.07)">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-page="/Events" style="color: var(--text)">MatchMate</a>
                <div class="navbar-nav flex-row gap-3">
                    <a class="nav-link" asp-page="/Events" style="color: var(--text2)">Matchhändelser</a>
                    <a class="nav-link" asp-page="/Lagbygge" style="color: var(--text2)">Lagbygge</a>
                    <a class="nav-link" asp-page="/Stats" style="color: var(--text2)">Matchstatistik</a>
                    <a class="nav-link" asp-page="/Sasongsstat" style="color: var(--text2)">Säsong</a>
                    <a class="nav-link" asp-page="/BytLosenord" style="color: var(--text2)">Byt lösenord</a>
                    <a class="nav-link" asp-page="/Logout" style="color: var(--red)">Logga ut</a>
                </div>
            </div>
        </nav>
    }
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Register the PWA service worker (enables install + offline app shell)
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function (err) {
                    console.warn('Service worker registration failed:', err);
                });
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
